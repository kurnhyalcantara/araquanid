# Binaries
/bin/
/dist/
*.exe

# Test & coverage
coverage.out
coverage.html

# Local config overrides. config/config.yaml is committed: it holds the default
# values and no secrets — supply those via ARAQUANID_ env vars.
config/config.local.yaml

# Local-dev-only RSA keypair for the login feature's JWT signer (`make dev-keys`)
configs/dev/*.pem

# Compose env files (hold platform secrets — ARAQUANID_POSTGRES__PASSWORD, ARAQUANID_JWT__SECRET)
.env
deployments/.env

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Dependencies
vendor/
